# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_NAME="EasyWorship"
APP_VERSION="0.1.0"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────
# Supabase PostgreSQL connection string (use transaction pooler for async)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/easyworship
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@localhost:5432/easyworship

# ─── JWT ───────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis (Celery broker + result backend) ─────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email — Resend ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@easyworship.co.ke
EMAIL_FROM_NAME="EasyWorship"

# ─── Africa's Talking (SMS) ─────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=EasyWorship

# ─── M-Pesa / Safaricom Daraja ──────────────────────────
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_BASE_URL=https://your-api-domain.com
# MPESA_ENV=sandbox  # or "production"
MPESA_ENV=sandbox

# ─── Cloudflare R2 (file storage) ───────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=easyworship-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
